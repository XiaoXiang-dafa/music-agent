<page-meta page-style="{{_scrollLock ? 'overflow: hidden;' : ''}}"></page-meta>
<!-- 搜索页 -->
<view class="container">
  <!-- 搜索头部：仅包裹搜索栏 + 联想下拉（relative 定位锚点） -->
  <view class="search-header">
    <view class="search-bar">
      <view class="search-input-wrap">
        <text class="search-icon">🔍</text>
        <input class="search-input" placeholder="搜索歌曲、歌手..."
          value="{{keyword}}" bindinput="onInput" bindconfirm="doSearch"
          confirm-type="search" focus="{{!searched}}" />
        <text class="search-clear" wx:if="{{keyword}}" bindtap="clearInput">✕</text>
      </view>
      <text class="search-btn" bindtap="doSearch">搜索</text>
    </view>

    <!-- ★ 音源切换标签 -->
    <view class="source-tabs">
      <view class="source-tab {{source === 'qq' ? 'active' : ''}}" data-source="qq" bindtap="switchSource">
        <text>QQ音乐</text>
      </view>
      <view class="source-tab {{source === 'netease' ? 'active' : ''}}" data-source="netease" bindtap="switchSource">
        <text>网易云</text>
      </view>
    </view>

    <!-- ★ 实时联想（absolute 悬浮在搜索栏正下方，不占文档流） -->
    <view class="suggest-dropdown" wx:if="{{suggestions.length > 0}}">
      <view class="suggest-item" wx:for="{{suggestions}}" wx:key="id"
        data-id="{{item.id}}" data-name="{{item.name}}" data-artist="{{item.artist}}" data-source="{{item.source}}"
        bindtap="tapSuggest">
        <text class="suggest-icon">🔍</text>
        <view class="suggest-info">
          <text class="suggest-name">{{item.name}}</text>
          <text class="suggest-artist">{{item.artist || '未知歌手'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 全屏半透明遮罩（独立于 search-header，点空白处收起联想） -->
  <view class="suggest-mask" wx:if="{{suggestions.length > 0}}" bindtap="dismissSuggest" catchtouchmove="noop"></view>

  <!-- 搜索历史 -->
  <view class="history-section" wx:if="{{showHistory && !searched && suggestions.length === 0}}">
    <view class="section-header">
      <text class="section-title">最近搜索</text>
      <text class="clear-btn" bindtap="clearHistory" wx:if="{{searchHistory.length > 0}}">清除</text>
    </view>
    <view class="history-tags" wx:if="{{searchHistory.length > 0}}">
      <text class="history-tag" wx:for="{{searchHistory}}" wx:key="index"
        data-kw="{{item}}" bindtap="tapHistory">{{item}}</text>
    </view>
    <view class="empty-hint" wx:if="{{searchHistory.length === 0}}">
      <text>搜索你想听的歌曲</text>
    </view>
  </view>

  <!-- 搜索结果 -->
  <scroll-view class="results-area" scroll-y wx:if="{{searched}}">
    <view class="loading-wrap" wx:if="{{loading}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">搜索中...</text>
    </view>

    <view class="empty-wrap" wx:if="{{!loading && songs.length === 0}}">
      <text class="empty-icon">🎵</text>
      <text class="empty-text">没有找到相关歌曲</text>
      <text class="empty-hint">试试其他关键词</text>
    </view>

    <view class="song-item" wx:for="{{songs}}" wx:key="id">
      <image class="song-cover" src="{{item.cover || '/images/default-cover.png'}}" mode="aspectFill" binderror="onCoverError" data-index="{{index}}" />
      <view class="song-info" data-id="{{item.id}}" data-name="{{item.name}}" data-artist="{{item.artist}}" data-cover="{{item.cover}}" data-source="{{item.source}}" bindtap="playSong">
        <text class="song-name">{{item.name}}</text>
        <text class="song-artist">{{item.artist || '未知歌手'}}{{item.album ? ' · ' + item.album : ''}}</text>
      </view>
      <view class="song-ops">
        <text class="op-btn" data-id="{{item.id}}" data-name="{{item.name}}" data-artist="{{item.artist}}" data-cover="{{item.cover}}" data-source="{{item.source}}" bindtap="addToQueue">+</text>
      </view>
    </view>
  </scroll-view>

  <!-- 迷你播放栏 -->
  <view class="bottom-area bottom-area-large">
    <mini-player />
  </view>

  <!-- 播放队列 -->
  <queue-panel />
</view>
