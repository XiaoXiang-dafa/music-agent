.queue-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5); z-index: 200;
  opacity: 0; pointer-events: none;
  transition: opacity 0.3s;
}
.queue-overlay.show { opacity: 1; pointer-events: auto; }

.queue-panel {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 201;
  background: #1A1A1A; border-radius: 24rpx 24rpx 0 0;
  max-height: 70vh; display: flex; flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  width: 100%; max-width: 100vw; box-sizing: border-box; overflow-x: hidden;
}
.queue-panel.show { transform: translateY(0); }

.queue-handle {
  width: 56rpx; height: 6rpx; background: rgba(255,255,255,0.25);
  border-radius: 4rpx; margin: 16rpx auto 20rpx;
  flex-shrink: 0;
}
.queue-header {
  display: flex; justify-content: space-between; align-items: center;
  padding: 0 32rpx; margin-bottom: 20rpx; flex-shrink: 0;
}
.queue-title { font-size: 32rpx; font-weight: 600; color: #fff; }
.queue-header-right { display: flex; gap: 24rpx; align-items: center; }
.queue-mode { font-size: 36rpx; }
.queue-clear { font-size: 24rpx; color: rgba(255,255,255,0.4); }

.queue-list { flex: 1; overflow-y: auto; overflow-x: hidden; padding: 0 32rpx calc(32rpx + env(safe-area-inset-bottom)); }
.queue-item {
  display: flex; align-items: center; padding: 16rpx 0;
  border-bottom: 0.5rpx solid rgba(255,255,255,0.05);
  width: 100%; box-sizing: border-box;
}
.queue-item.active {
  background: rgba(7,193,96,0.08); border-radius: 12rpx; padding: 16rpx 12rpx;
}
.queue-cover-small {
  width: 72rpx; height: 72rpx; border-radius: 8rpx; flex-shrink: 0;
  background: rgba(255,255,255,0.05);
}
.queue-item-info { flex: 1; margin-left: 16rpx; min-width: 0; overflow: hidden; }
.queue-item-name {
  font-size: 26rpx; color: rgba(255,255,255,0.7); display: block;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.queue-item-name.playing { color: #07C160; font-weight: 500; }
.queue-item-artist {
  font-size: 22rpx; color: rgba(255,255,255,0.35); margin-top: 2rpx;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.queue-item-del {
  margin-left: 0; margin-right: 28rpx; padding: 12rpx; flex-shrink: 0;
  color: rgba(255,255,255,0.25); font-size: 36rpx;
}
.queue-empty {
  text-align: center; color: rgba(255,255,255,0.25);
  padding: 60rpx 0; font-size: 26rpx;
}
